    {
      "name": "3. Customer Order Flow",
      "item": [
        {
          "name": "Create Order",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status is 201', () => pm.response.to.have.status(201));",
            "const json = pm.response.json();",
            "pm.collectionVariables.set('orderId', json.id);",
            "pm.test('Status is NEW', () => json.status === 'NEW');",
            "pm.test('Total amount is 120', () => json.totalAmount === 120.0);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerName\": \"Postman Test Customer\",\n  \"customerPhone\": \"{{customerPhone}}\",\n  \"communityId\": {{communityId}},\n  \"tower\": \"A\",\n  \"flatNumber\": \"101\",\n  \"notes\": \"Test order created via Postman\",\n  \"items\": [\n    {\n      \"menuItemId\": {{menuItemId}},\n      \"quantity\": 1,\n      \"selectedOptionIds\": [{{variantOptionId}}]\n    }\n  ]\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/orders", "host": ["{{baseUrl}}"], "path": ["api", "orders"] }
          }
        },
        {
          "name": "Get Order by ID",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status is 200', () => pm.response.to.have.status(200));",
            "pm.test('Order id matches', () => pm.response.json().id == pm.collectionVariables.get('orderId'));"
          ] } }],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/orders/{{orderId}}", "host": ["{{baseUrl}}"], "path": ["api", "orders", "{{orderId}}"] }
          }
        },
        {
          "name": "Get Recent Orders by Phone",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status is 200', () => pm.response.to.have.status(200));",
            "pm.test('Includes our test order', () => pm.response.json().some(o => o.id == pm.collectionVariables.get('orderId')));"
          ] } }],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/orders/recent?phone={{customerPhone}}", "host": ["{{baseUrl}}"], "path": ["api", "orders", "recent"], "query": [{ "key": "phone", "value": "{{customerPhone}}" }] }
