          "request": {
            "method": "DELETE",
            "header": [{ "key": "X-Admin-Key", "value": "{{adminApiKey}}" }],
            "url": { "raw": "{{baseUrl}}/api/admin/menu/{{menuItemId}}", "host": ["{{baseUrl}}"], "path": ["api", "admin", "menu", "{{menuItemId}}"] }
          }
