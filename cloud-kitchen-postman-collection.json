          ] } }],
          "request": {
            "method": "DELETE",
            "header": [{ "key": "X-Admin-Key", "value": "{{adminApiKey}}" }],
            "url": { "raw": "{{baseUrl}}/api/admin/delivery-agents/{{deliveryAgentId}}", "host": ["{{baseUrl}}"], "path": ["api", "admin", "delivery-agents", "{{deliveryAgentId}}"] }
          }
        },
        {
          "name": "Deactivate Community",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
