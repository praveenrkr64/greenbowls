              "raw": "{\n  \"name\": \"Postman Test Bowl\",\n  \"description\": \"Created via Postman collection for API testing\",\n  \"basePrice\": 100.00,\n  \"category\": \"BOWL\",\n  \"imageUrl\": \"\",\n  \"active\": true,\n  \"sortOrder\": 99,\n  \"variantGroups\": [\n    {\n      \"name\": \"Choose your base\",\n      \"required\": true,\n      \"minSelect\": 1,\n      \"maxSelect\": 1,\n      \"sortOrder\": 1,\n      \"options\": [\n        { \"name\": \"Rice\", \"priceDelta\": 0, \"active\": true, \"sortOrder\": 1 },\n        { \"name\": \"Quinoa\", \"priceDelta\": 20, \"active\": true, \"sortOrder\": 2 }\n      ]\n    }\n  ]\n}"
