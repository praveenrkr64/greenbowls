              ]
            },
            "url": { "raw": "{{baseUrl}}/api/admin/uploads", "host": ["{{baseUrl}}"], "path": ["api", "admin", "uploads"] },
            "description": "Attach an image file in the Body tab (form-data, key 'file') before sending."
          }
        }
      ]
    },
    {
      "name": "8. Auth & Validation Checks",
      "item": [
        {
          "name": "Admin endpoint without X-Admin-Key -> 401",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status is 401', () => pm.response.to.have.status(401));"
          ] } }],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/admin/communities", "host": ["{{baseUrl}}"], "path": ["api", "admin", "communities"] }
          }
        },
        {
          "name": "Admin endpoint with wrong X-Admin-Key -> 401",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status is 401', () => pm.response.to.have.status(401));"
          ] } }],
          "request": {
            "method": "GET",
            "header": [{ "key": "X-Admin-Key", "value": "wrong-key-entirely" }],
            "url": { "raw": "{{baseUrl}}/api/admin/communities", "host": ["{{baseUrl}}"], "path": ["api", "admin", "communities"] }
          }
        },
        {
          "name": "Create order with invalid phone -> 400",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status is 400', () => pm.response.to.have.status(400));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerName\": \"Bad Phone Test\",\n  \"customerPhone\": \"12345\",\n  \"communityId\": {{communityId}},\n  \"tower\": \"A\",\n  \"flatNumber\": \"101\",\n  \"items\": [ { \"menuItemId\": {{menuItemId}}, \"quantity\": 1, \"selectedOptionIds\": [{{variantOptionId}}] } ]\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/orders", "host": ["{{baseUrl}}"], "path": ["api", "orders"] }
          }
        },
        {
          "name": "Delivery agent with wrong secret key -> 400",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status is 400', () => pm.response.to.have.status(400));",
            "pm.test('Generic error - no phone enumeration', () => pm.response.json().error === 'Invalid phone number or key');"
          ] } }],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/orders/assigned?phone={{agentPhone}}&key=totally-wrong-key", "host": ["{{baseUrl}}"], "path": ["api", "orders", "assigned"], "query": [
              { "key": "phone", "value": "{{agentPhone}}" },
              { "key": "key", "value": "totally-wrong-key" }
            ] }
          }
        }
      ]
    },
    {
      "name": "9. Cleanup (deactivate test data)",
      "item": [
        {
          "name": "Deactivate Menu Item",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status is 204', () => pm.response.to.have.status(204));"
